# FUSION BOT configuration
#
# Copy this file to `.env` and fill in your own values.
# NEVER paste a token or key into a chat window, an issue, or a PR — this file
# stays on your machine (it is git-ignored), and the same values go into
# GitHub → Settings → Secrets and variables → Actions for the workflows.

# ---------------------------------------------------------------- Telegram
# BotFather gives you the token; the owner chat id is YOUR numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
# Optional custom output formatting (standard | brief | tactical | compact | custom):
# TELEGRAM_SIGNAL_STYLE=standard
# TELEGRAM_RESULT_STYLE=standard
# TELEGRAM_APPLY_TO_SIGNALS_CMD=0
# TELEGRAM_SIGNAL_TEMPLATE=
# TELEGRAM_RESULT_TEMPLATE=

# ---------------------------------------------------------------- Supabase
# Project Settings → API. Use the service_role key here (it stays local).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------ Twelve Data
# One key is enough. Slots 1..30 exist only for keys you have legitimately
# provisioned — do not create multiple free accounts to work around rate limits.
TWELVE_DATA_API_KEY=
# TWELVE_DATA_KEY_1=
# TWELVE_DATA_KEY_2=
# TWELVE_DATA_KEY_3=

# ----------------------------------------------------------------- market
PAIR=EUR/USD
# Evaluate multiple spot markets in one cycle (FX + 24/7 spot crypto):
# PAIRS=EUR/USD,BTC/USD,ETH/USD
TIMEFRAME=1min
CANDLE_HISTORY=320
SIGNAL_HORIZON_MINUTES=30

# Aggressive short-horizon mode: when the default 30-min can't pay, try 1-min
# and 3-min with a relaxed cost gate. Minimum 1.5x spread so the trade still
# pays for itself. Set SHORT_HORIZON_MAX_MINUTES=0 to disable.
# SHORT_HORIZON_MAX_MINUTES=3
# SHORT_HORIZON_MIN_REWARD=1.5

# Sureshot auto-detection: when model confidence exceeds this AND present
# conditions align (volatility OK, spread OK, session active, trend aligned),
# the signal is flagged SURESHOT and the expiry is auto-selected.
# SURESHOT_CONFIDENCE_THRESHOLD=0.72

# Hold long enough to pay for the trip. Off by default so an existing install
# behaves exactly as before. With it on, a signal whose configured hold cannot
# cover its own round-turn cost is stretched to the shortest hold that can, and
# a market where NO hold can pay produces no signal at all.
#
# Run `python scripts/economics.py 1.5` to see whether your numbers need it.
# At a realistic EUR/USD M1 ATR of 1.5 pips, a 5-minute hold cannot pay a 1.2
# pip round turn — it needs about 40 minutes.
# ADAPTIVE_HORIZON=1
#
# Off means "use the configured hold, but still refuse it when it cannot pay".
# The cost test is unconditional; only the stretching is optional. Either way a
# hold whose projected move is smaller than the toll is never taken.
# How many times the round-turn cost the projected move must be. 1.0 is break
# even before any model error, which is not a trade.
# REWARD_TO_COST=3.0
# Never hold longer than this, however quiet the market is.
# MAX_HORIZON_MINUTES=120

# Narrow which strategies may speak by FX session (Asia ranges, London and the
# overlap trend). Validated as a mechanism by scripts/validate_edge.py.
# SESSION_FILTER=1

# Higher-timeframe MTF alignment (locally resampled from M1 candles; 0 extra API calls)
# and scheduled high-impact news blackout (US NFP + optional explicit UTC windows).
# MTF_FILTER=1
# MTF_MINUTES=15
# MTF_MIN_GAP_BPS=2.0
# MTF_MACRO_FILTER=0
# MTF_MACRO_MIN_GAP_BPS=1.5
# NEWS_FILTER=1
# NEWS_BLACKOUT_WINDOWS=

# ------------------------------------------------------------------ gates
# Drop a signal if it cannot be sealed within this many seconds of the minute
# opening. A late signal is discarded, never backdated.
MAX_SEAL_LATENCY_SECONDS=10
MAX_CANDLE_AGE_SECONDS=180
# Leave MAX_SPREAD_PIPS unset and it defaults to SPREAD_PIPS x 1.9, so the gate
# moves with the cost you actually assume. An absolute number used to sit 0.02
# pips under the modelled off-hours spread -- a coincidence, not a decision, and
# it silently inverted if you changed SPREAD_PIPS.
# MAX_SPREAD_PIPS=2.5
SPREAD_PIPS=1.2
MAX_UNCERTAINTY=0.10
MIN_CONFLUENCE_CHECKS=5
MIN_CALIBRATION_POINTS=60
# Freqtrade & Nyao-inspired protection shields:
# SIGNAL_COOLDOWN_MINUTES=15
# LOSS_GUARD_STREAK=3
# LOSS_GUARD_LOOKBACK_MINUTES=180
# LOSS_GUARD_COOLDOWN_MINUTES=60
# LOSS_GUARD_SHADOW_RECOVERY=1
# FX_ROLLOVER_GUARD=1

# --------------------------------------------------------------- learning
NIGHTLY_MIN_SAMPLES=400
NIGHTLY_TRAIN_FRACTION=0.70
ONLINE_LEARNING_RATE=0.02

# ---------------------------------------------------------------- runtime
TICK_SECONDS=15
HEARTBEAT_STALE_SECONDS=90
DIGEST_HOUR_UTC=0
DIGEST_MINUTE_UTC=5
NIGHTLY_HOUR_UTC=23
NIGHTLY_MINUTE_UTC=55
RUNNER=github-actions
LOCAL_STATE_DIR=var
