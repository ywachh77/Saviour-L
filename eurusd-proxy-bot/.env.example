# FUSION BOT configuration
#
# Copy this file to `.env` and fill in your own values.
# NEVER paste a token or key into a chat window, an issue, or a PR — this file
# stays on your machine (it is git-ignored), and the same values go into
# GitHub → Settings → Secrets and variables → Actions for the workflows.

# ---------------------------------------------------------------- Telegram
# BotFather gives you the token; the owner chat id is YOUR numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ---------------------------------------------------------------- Supabase
# Project Settings → API. Use the service_role key here (it stays local).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------ Twelve Data
# One key is enough. Slots 1..30 exist only for keys you have legitimately
# provisioned — do not create multiple free accounts to work around rate limits.
TWELVE_DATA_API_KEY=
# TWELVE_DATA_KEY_1=
# TWELVE_DATA_KEY_2=
# TWELVE_DATA_KEY_3=

# ----------------------------------------------------------------- market
PAIR=EUR/USD
TIMEFRAME=1min
CANDLE_HISTORY=320
SIGNAL_HORIZON_MINUTES=5

# ------------------------------------------------------------------ gates
# Drop a signal if it cannot be sealed within this many seconds of the minute
# opening. A late signal is discarded, never backdated.
MAX_SEAL_LATENCY_SECONDS=10
MAX_CANDLE_AGE_SECONDS=180
MAX_SPREAD_PIPS=2.5
SPREAD_PIPS=1.2
MAX_UNCERTAINTY=0.10
MIN_CONFLUENCE_CHECKS=5
MIN_CALIBRATION_POINTS=60

# --------------------------------------------------------------- learning
NIGHTLY_MIN_SAMPLES=400
NIGHTLY_TRAIN_FRACTION=0.70
ONLINE_LEARNING_RATE=0.02

# ---------------------------------------------------------------- runtime
TICK_SECONDS=15
HEARTBEAT_STALE_SECONDS=90
DIGEST_HOUR_UTC=0
DIGEST_MINUTE_UTC=5
NIGHTLY_HOUR_UTC=23
NIGHTLY_MINUTE_UTC=55
RUNNER=termux
LOCAL_STATE_DIR=var
