# FUSION BOT configuration
#
# Copy this file to `.env` and fill in your own values.
# NEVER paste a token or key into a chat window, an issue, or a PR — this file
# stays on your machine (it is git-ignored), and the same values go into
# GitHub → Settings → Secrets and variables → Actions for the workflows.

# ---------------------------------------------------------------- Telegram
# BotFather gives you the token; the owner chat id is YOUR numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ---------------------------------------------------------------- Supabase
# Project Settings → API. Use the service_role key here (it stays local).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------ Twelve Data
# One key is enough. Slots 1..30 exist only for keys you have legitimately
# provisioned — do not create multiple free accounts to work around rate limits.
TWELVE_DATA_API_KEY=
# TWELVE_DATA_KEY_1=
# TWELVE_DATA_KEY_2=
# TWELVE_DATA_KEY_3=

# ----------------------------------------------------------------- market
PAIR=EUR/USD
TIMEFRAME=1min
CANDLE_HISTORY=320
SIGNAL_HORIZON_MINUTES=5

# Hold long enough to pay for the trip. Off by default so an existing install
# behaves exactly as before. With it on, a signal whose configured hold cannot
# cover its own round-turn cost is stretched to the shortest hold that can, and
# a market where NO hold can pay produces no signal at all.
#
# Run `python scripts/economics.py 1.5` to see whether your numbers need it.
# At a realistic EUR/USD M1 ATR of 1.5 pips, a 5-minute hold cannot pay a 1.2
# pip round turn — it needs about 40 minutes.
# ADAPTIVE_HORIZON=0
# How many times the round-turn cost the projected move must be. 1.0 is break
# even before any model error, which is not a trade.
# REWARD_TO_COST=3.0
# Never hold longer than this, however quiet the market is.
# MAX_HORIZON_MINUTES=120

# ------------------------------------------------------------------ gates
# Drop a signal if it cannot be sealed within this many seconds of the minute
# opening. A late signal is discarded, never backdated.
MAX_SEAL_LATENCY_SECONDS=10
MAX_CANDLE_AGE_SECONDS=180
MAX_SPREAD_PIPS=2.5
SPREAD_PIPS=1.2
MAX_UNCERTAINTY=0.10
MIN_CONFLUENCE_CHECKS=5
MIN_CALIBRATION_POINTS=60

# --------------------------------------------------------------- learning
NIGHTLY_MIN_SAMPLES=400
NIGHTLY_TRAIN_FRACTION=0.70
ONLINE_LEARNING_RATE=0.02

# ---------------------------------------------------------------- runtime
TICK_SECONDS=15
HEARTBEAT_STALE_SECONDS=90
DIGEST_HOUR_UTC=0
DIGEST_MINUTE_UTC=5
NIGHTLY_HOUR_UTC=23
NIGHTLY_MINUTE_UTC=55
RUNNER=termux
LOCAL_STATE_DIR=var
